# Copy this file to .env.local and fill in a real Supabase project's values
# (Project Settings → API → Publishable key — NOT the legacy anon key, see TODO.md §4.1).
# .env.local is gitignored; this .env.example is the only one that gets committed.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
