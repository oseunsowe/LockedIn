# Copy this file to .env.local and fill in a real Supabase project's values
# (Project Settings → API → Publishable key — NOT the legacy anon key, see TODO.md §4.1).
# .env.local is gitignored; this .env.example is the only one that gets committed.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google Sign-In (TODO.md §17.1). Web application OAuth client ID from Google Cloud Console
# (APIs & Services → Credentials) — this is the "Web client" type even though it's used from a
# mobile app, because @react-native-google-signin/google-signin needs it to request an ID token
# Supabase can verify (supabase.auth.signInWithIdToken({ provider: 'google', ... })). Also needs
# the app's release/debug SHA-1 fingerprint registered against an Android OAuth client in the same
# Google Cloud project — the web client ID alone isn't enough on Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
