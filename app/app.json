{
  "expo": {
    "name": "LockedIn",
    "slug": "lockedin",
    "scheme": "lockedin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050508",
    "ios": {
      "bundleIdentifier": "com.lockedin.app",
      "supportsTablet": true,
      "backgroundColor": "#050508",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LockedIn uses your camera to capture proof that you completed a mission.",
        "NSMicrophoneUsageDescription": "LockedIn uses your microphone to record voice reflections as proof of mission completion.",
        "NSPhotoLibraryUsageDescription": "LockedIn uses your photo library to find forgotten goals in your screenshots and turn them into missions, and to let you attach screenshots as proof."
      }
    },
    "android": {
      "package": "com.lockedin.app",
      "backgroundColor": "#050508",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#050508"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#050508"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "LockedIn lets you pick screenshots to find forgotten goals and photos to attach as mission proof.",
          "cameraPermission": "LockedIn uses your camera to capture proof that you completed a mission.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6365F1",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68a46ac4-ff1e-4167-b77b-7b8c802cf093"
      }
    },
    "owner": "kimkemp"
  }
}
