# The committed package-lock.json was generated with --legacy-peer-deps (see TODO.md §0.3's own
# note: a plain `npm ci` resolves a different, broken dependency tree without it). GitHub Actions
# already passes the flag explicitly; this file makes EAS Build's own "Install dependencies" phase
# (which runs a plain `npm install` with no way to pass extra flags) do the same automatically,
# rather than erroring on the exact ERESOLVE conflict already documented and solved once here.
legacy-peer-deps=true
