# This is a small, frequently-iterated static marketing page (no build step, no cache-busted
# filenames) — long browser caching on HTML/CSS causes real staleness bugs after every deploy
# (a visitor's browser can silently keep serving a pre-redesign stylesheet against fresh markup,
# breaking layout in ways that look like a server bug but aren't). Keep HTML always-revalidated
# and assets short-cached until this site adopts versioned filenames.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|webp|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Landing v2: self-hosted fonts and hashed-by-name media never change under the same filename.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType text/javascript .js
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json image/svg+xml
</IfModule>
